local currentOverlay = nil
local connection = nil

local function clearOldOverlay()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	if currentOverlay then
		currentOverlay:Destroy()
		currentOverlay = nil
	end

	local char = LocalPlayer.Character
	if char then
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.LocalTransparencyModifier = 0
			elseif part:IsA("Decal") or part:IsA("Texture") then
				part.Transparency = 0
			end
		end
	end
end

local function applyFullAvatar(username)
	clearOldOverlay()

	local success, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)

	if not success or not userId then
		CopyButton.Text = "Invalid Username!"
		task.wait(1.8)
		CopyButton.Text = "Copy Full Skin"
		return
	end

	CopyButton.Text = "Loading..."

	local modelSuccess, model = pcall(function()
		return Players:CreateHumanoidModelFromUserIdAsync(userId)
	end)

	if not modelSuccess or not model then
		CopyButton.Text = "Failed to load"
		task.wait(1.8)
		CopyButton.Text = "Copy Full Skin"
		return
	end

	task.wait(1.5)

	local character = LocalPlayer.Character
	if not character then
		model:Destroy()
		CopyButton.Text = "No Character"
		task.wait(1.5)
		CopyButton.Text = "Copy Full Skin"
		return
	end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		model:Destroy()
		return
	end

	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name \~= "HumanoidRootPart" then
			part.LocalTransparencyModifier = 1
		elseif part:IsA("Decal") or part:IsA("Texture") then
			part.Transparency = 1
		end
	end

	model.Name = "LocalAvatarOverlay"
	model.Parent = workspace

	local overlayHRP = model:FindFirstChild("HumanoidRootPart")
	if not overlayHRP then
		model:Destroy()
		clearOldOverlay()
		return
	end

	overlayHRP.Anchored = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = overlayHRP
	weld.Parent = overlayHRP

	model:PivotTo(hrp.CFrame)

	local overlayHum = model:FindFirstChildOfClass("Humanoid")
	if overlayHum then
		overlayHum.PlatformStand = true
		overlayHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	currentOverlay = model

	connection = RunService.RenderStepped:Connect(function()
		if currentOverlay and currentOverlay.Parent and hrp and hrp.Parent then
			currentOverlay:PivotTo(hrp.CFrame)
		else
			clearOldOverlay()
		end
	end)

	CopyButton.Text = "Copied!"
	task.wait(1.5)
	CopyButton.Text = "Copy Full Skin"
end

CopyButton.MouseButton1Click:Connect(function()
	local username = TextBox.Text:gsub("%s+", "")
	if username == "" then return end
	applyFullAvatar(username)
end)

RemoveButton.MouseButton1Click:Connect(function()
	clearOldOverlay()
	RemoveButton.Text = "Removed"
	task.wait(1)
	RemoveButton.Text = "Remove"
end)

Frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		clearOldOverlay()
		ScreenGui:Destroy()
	end
end)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1.2)
	clearOldOverlay()
end)

print("Full Skin Copier loaded successfully!")
